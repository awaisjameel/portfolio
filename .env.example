# Copy to .env for local development.
NUXT_PUBLIC_SITE_URL=http://localhost:3001
NUXT_SITE_INDEXABLE=false

# Leave SMTP blank locally: the contact form then reports that sending is unavailable.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=
NUXT_SMTP_PASSWORD=
NUXT_SMTP_FROM=
NUXT_CONTACT_TO=

# Optional. Without a token, the contribution graph keeps the snapshot in shared/data.
NUXT_GITHUB_TOKEN=

# Optional. The WhatsApp button appears only when a number is set, digits only.
NUXT_PUBLIC_WHATSAPP_NUMBER=

# Optional cookie-free analytics (Umami-compatible script).
NUXT_PUBLIC_ANALYTICS_SRC=
NUXT_PUBLIC_ANALYTICS_WEBSITE_ID=
