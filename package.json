    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "gray-matter": "4.0.3",
    "marked": "18.1.2",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
